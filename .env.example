# 로컬 개발용 설정 예시. 복사해서 .env 로 만들고 비밀번호를 바꾼다. (.env 는 커밋 금지)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=yeonos
DB_OWNER_USER=yeonos_owner
DB_OWNER_PASSWORD=change-me-owner
DB_APP_USER=yeonos_app
DB_APP_PASSWORD=change-me-app
SERVER_PORT=8090
DEPLOY_MODE=saas
# 리버스 프록시 뒤일 때만: X-Forwarded-For 를 믿을 프록시 주소(CIDR 목록 또는 정규식). 비우면 아무도 안 믿음
TRUSTED_PROXIES=
# 로컬 개발 계정 (회사 DEMO / 아이디 admin)
DEV_ADMIN_PASSWORD=change-me-admin
# 운영자 콘솔 (/ops) — 허용 IP 는 기본 127.0.0.1. 키는 openssl rand -base64 32 로 만든다
OPS_SECRET_KEY=
OPS_BOOTSTRAP_LOGIN=ops
OPS_BOOTSTRAP_PASSWORD=change-me-ops-12chars
# 메일 알림 (docs/36 18.3) — 켜면 SMTP 서버·보내는 주소가 꼭 있어야 한다. 계정·비밀번호는 .env 에만(커밋 금지)
MAIL_ENABLED=false
MAIL_FROM=
MAIL_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Web Push (docs/45 9장) — VAPID 키 쌍(P-256, base64url: 공개 65바이트·개인 32바이트)과 연락처(mailto:…). 비우면 푸시 꺼짐.
# 키는 .env·서버 환경에만(커밋·공유 문서 금지). 만드는 법은 deploy/README.md "Web Push 키"
HAPPYBOOT_PUSH_VAPID_PUBLIC_KEY=
HAPPYBOOT_PUSH_VAPID_PRIVATE_KEY=
HAPPYBOOT_PUSH_VAPID_SUBJECT=
# 현장 단말 APK 배포 파일 위치(docs/50 F1) — yeonos-pda.apk + release.json 을 운영자가 놓는다. 서명 키는 여기 두지 않는다
PDA_APK_DIR=./data/pda
# 운영 지표 /actuator/prometheus (docs/52 Y2, deploy/monitoring/README.md) — 로컬은 이 PC 에서만 열린다(허용 IP 밖은 404).
# 운영(prod)은 METRICS_ENDPOINT=read-only 로 열고 MANAGEMENT_SERVER_PORT·MANAGEMENT_SERVER_ADDRESS·METRICS_TOKEN 을 함께 준다
METRICS_ALLOWED_IPS=127.0.0.1/32,::1/128
METRICS_TOKEN=
METRICS_COMP_TAG=false
