# deploy/ci/jenkins/.env 로 복사해 값을 바꾼다(.env 는 커밋 금지 — .gitignore). docs/71·deploy/ci/README.md
JENKINS_ADMIN_ID=admin
# 16자 이상 무작위로. 첫 기동 뒤에도 이 값이 관리자 비밀번호다(JCasC 가 재시작 때마다 맞춘다)
JENKINS_ADMIN_PASSWORD=change-me-to-a-long-random-value
JENKINS_PORT=8095
# 보통 그대로. GitHub 토큰은 여기에 넣지 않는다 — Jenkins 화면 자격증명(github-yeonos)에만
YEONOS_GIT_URL=https://github.com/Dong-yeon/YeonOS.git
