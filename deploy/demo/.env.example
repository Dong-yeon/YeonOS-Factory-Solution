# 공개 데모 VM 설정 예시 → /opt/yeonos/.env 로 복사(chmod 600). 이 파일 외에는 비밀을 두지 않는다(GitHub Secrets 에는 SSH 정보만).
# DB 비밀번호는 영문·숫자 16자 이상: openssl rand -hex 24
DOMAIN=localhost
DB_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_BACKUP_PASSWORD=
# 데모 계정(회사 DEMO / 아이디 user1) 비밀번호 — 로그인 화면·README 에 공개하는 값(2026-10-26: yeonos-demo-1234). 12자 이상이어야 기동한다
DEMO_PASSWORD=yeonos-demo-1234
# 관리자 MFA 비밀 봉인 키(Base64 32바이트) — openssl rand -base64 32 로 **한 번만** 만들고 바꾸지 않는다(바꾸면 등록된 2단계 인증을 모두 다시 등록).
# 없으면 compose 가 멈춘다(운영 기동 가드가 요구 — docs/67 F4). 키 사본은 VM 밖 비밀 보관소에도
MFA_SECRET_KEY=
